# Copiá este archivo como .env.local y completá los valores.
# Si dejás una variable vacía, la app usa un "modo demo" para esa parte.

# Dirección pública de la app (sin barra al final)
APP_URL=http://localhost:3000

# Clave larga y secreta para las sesiones (cualquier texto de 32+ caracteres)
SESSION_SECRET=

# Emails de los socios, separados por coma: entran directo al panel de admin
ADMIN_EMAILS=

# Base de datos (Supabase > Project settings > Database > Connection string, modo "Transaction")
# Vacío = base local de prueba en la carpeta .data
DATABASE_URL=

# Stripe (Developers > API keys). Vacío = los pagos se aprueban solos (demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend para emails (resend.com > API keys). Vacío = los emails se muestran en la consola
RESEND_API_KEY=
EMAIL_FROM=Clara <hola@claracleanmiami.com>

# Cloudflare Stream para videos. Vacío = los videos se guardan en la carpeta .data (demo)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Clave para las tareas automáticas diarias (Vercel la manda sola si se llama CRON_SECRET)
CRON_SECRET=
